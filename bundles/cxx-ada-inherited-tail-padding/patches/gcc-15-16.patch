diff --git a/gcc/c-family/c-ada-spec.cc b/gcc/c-family/c-ada-spec.cc
--- a/gcc/c-family/c-ada-spec.cc
+++ b/gcc/c-family/c-ada-spec.cc
@@ -2875,6 +2875,102 @@ dump_ada_methods (pretty_printer *pp, tree node, int spc)
   return 1;
 }
 
+/* Return true if NODE needs an explicit Ada layout to describe C++ tail
+   padding, either because its object size exceeds its size as a base class or
+   because it places a field in a direct base class's tail padding.  */
+
+static bool
+needs_tail_padding_layout (tree node)
+{
+  if (!cpp_check || !is_tagged_type (node))
+    return false;
+
+  const int data_size = cpp_check (node, GET_AS_BASE_SIZE);
+  const HOST_WIDE_INT object_size = int_size_in_bytes (node);
+  return (data_size >= 0 && object_size > data_size)
+	 || cpp_check (node, REUSES_BASE_TAIL_PADDING);
+}
+
+/* Return true if all of NODE's fields that are visible in the generated Ada
+   record have constant positions and sizes suitable for component clauses.  */
+
+static bool
+has_constant_field_layout (tree node)
+{
+  for (tree field = TYPE_FIELDS (node); field; field = TREE_CHAIN (field))
+    if (TREE_CODE (field) == FIELD_DECL
+	&& DECL_NAME (field)
+	&& !DECL_VIRTUAL_P (field)
+	&& (!DECL_FIELD_OFFSET (field)
+	    || !DECL_FIELD_BIT_OFFSET (field)
+	    || !DECL_SIZE (field)
+	    || !tree_fits_uhwi_p (DECL_FIELD_OFFSET (field))
+	    || !tree_fits_uhwi_p (DECL_FIELD_BIT_OFFSET (field))
+	    || !tree_fits_uhwi_p (DECL_SIZE (field))
+	    || tree_to_uhwi (DECL_SIZE (field)) == 0))
+      return false;
+
+  return true;
+}
+
+/* Dump the size and component clauses needed to preserve NODE's C++ tail
+   padding layout.  TYPE is the declaration used for Ada name qualification.  */
+
+static void
+dump_ada_tail_padding_layout (pretty_printer *pp, tree node, tree type, int spc)
+{
+  const int data_size = cpp_check (node, GET_AS_BASE_SIZE);
+  const HOST_WIDE_INT object_size = int_size_in_bytes (node);
+
+  gcc_assert (data_size >= 0 && object_size >= 0);
+
+  newline_and_indent (pp, spc);
+  pp_string (pp, "for ");
+  dump_ada_node (pp, TYPE_NAME (node), type, spc, false, true);
+  pp_string (pp, "'Size use ");
+  pp_wide_integer (pp, (HOST_WIDE_INT) data_size * BITS_PER_UNIT);
+  pp_semicolon (pp);
+
+  newline_and_indent (pp, spc);
+  pp_string (pp, "for ");
+  dump_ada_node (pp, TYPE_NAME (node), type, spc, false, true);
+  pp_string (pp, "'Object_Size use ");
+  pp_wide_integer (pp, object_size * BITS_PER_UNIT);
+  pp_semicolon (pp);
+
+  newline_and_indent (pp, spc);
+  pp_string (pp, "for ");
+  dump_ada_node (pp, TYPE_NAME (node), type, spc, false, true);
+  pp_string (pp, " use record");
+
+  for (tree field = TYPE_FIELDS (node); field; field = TREE_CHAIN (field))
+    if (TREE_CODE (field) == FIELD_DECL
+	&& DECL_NAME (field)
+	&& !DECL_VIRTUAL_P (field))
+      {
+	const unsigned HOST_WIDE_INT bitpos
+	  = tree_to_uhwi (DECL_FIELD_OFFSET (field)) * BITS_PER_UNIT
+	    + tree_to_uhwi (DECL_FIELD_BIT_OFFSET (field));
+	const unsigned HOST_WIDE_INT position = bitpos / BITS_PER_UNIT;
+	const unsigned HOST_WIDE_INT first_bit = bitpos % BITS_PER_UNIT;
+	const unsigned HOST_WIDE_INT last_bit
+	  = first_bit + tree_to_uhwi (DECL_SIZE (field)) - 1;
+
+	newline_and_indent (pp, spc + INDENT_INCR);
+	dump_ada_decl_name (pp, field, false);
+	pp_string (pp, " at ");
+	pp_unsigned_wide_integer (pp, position);
+	pp_string (pp, " range ");
+	pp_unsigned_wide_integer (pp, first_bit);
+	pp_string (pp, " .. ");
+	pp_unsigned_wide_integer (pp, last_bit);
+	pp_semicolon (pp);
+      }
+
+  newline_and_indent (pp, spc);
+  pp_string (pp, "end record;");
+}
+
 /* Dump in PP a forward declaration for TYPE present inside T.
    SPC is the indentation level.  */
 
@@ -3897,6 +3993,18 @@ dump_ada_structure (pretty_printer *pp, tree node, tree type, bool nested,
 
   need_semicolon = !dump_ada_methods (pp, node, spc);
 
+  if (needs_tail_padding_layout (node) && has_constant_field_layout (node))
+    {
+      if (need_semicolon)
+	{
+	  need_semicolon = false;
+	  pp_semicolon (pp);
+	}
+
+      pp_newline (pp);
+      dump_ada_tail_padding_layout (pp, node, type, spc);
+    }
+
   /* Print the static fields of the structure, if any.  */
   for (tree tmp = TYPE_FIELDS (node); tmp; tmp = TREE_CHAIN (tmp))
     {
