   GET_FUNCTION_QUALIFIERS,
   HAS_DEPENDENT_TEMPLATE_ARGS,
   IS_ABSTRACT,
@@ -34,7 +35,8 @@ enum cpp_operation {
   IS_COPY_CONSTRUCTOR,
