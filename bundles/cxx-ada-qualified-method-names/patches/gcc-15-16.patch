diff --git a/gcc/c-family/c-ada-spec.cc b/gcc/c-family/c-ada-spec.cc
--- a/gcc/c-family/c-ada-spec.cc
+++ b/gcc/c-family/c-ada-spec.cc
@@ -2936,6 +2936,27 @@ print_assignment_operator (pretty_printer *pp, tree t, tree type)
 
   pp_string (pp, "Assign_");
   pp_ada_tree_identifier (pp, decl_name, t, false);
+
+  if (cpp_check (t, GET_FUNCTION_QUALIFIERS)
+	& CPP_FUNCTION_MOVE_ASSIGNMENT)
+    pp_string (pp, "_Move");
+}
+
+/* Append the C++ method qualifiers that Ada profiles cannot represent.  */
+
+static void
+print_method_qualifiers (pretty_printer *pp, tree t)
+{
+  const int qualifiers = cpp_check (t, GET_FUNCTION_QUALIFIERS);
+
+  if (qualifiers & CPP_FUNCTION_CONST)
+    pp_string (pp, "_Const");
+  if (qualifiers & CPP_FUNCTION_VOLATILE)
+    pp_string (pp, "_Volatile");
+  if (qualifiers & CPP_FUNCTION_LVALUE)
+    pp_string (pp, "_Lvalue");
+  else if (qualifiers & CPP_FUNCTION_RVALUE)
+    pp_string (pp, "_Rvalue");
 }
 
 /* Return the name of type T.  */
