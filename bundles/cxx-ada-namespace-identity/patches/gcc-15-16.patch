diff --git a/gcc/c-family/c-ada-spec.cc b/gcc/c-family/c-ada-spec.cc
--- a/gcc/c-family/c-ada-spec.cc
+++ b/gcc/c-family/c-ada-spec.cc
@@ -1381,3 +1381,26 @@ separate_class_package (tree decl)
 }
 
+/* Dump the named C++ namespace path containing DECL, using underscores as
+   separators so the entity remains in the generated Ada package.  */
+
+static void
+pp_ada_namespace_prefix (pretty_printer *pp, tree decl)
+{
+  if (!cpp_check || !decl)
+    return;
+
+  tree context = DECL_CONTEXT (decl);
+  if (!context || TREE_CODE (context) != NAMESPACE_DECL
+      || !DECL_NAME (context))
+    return;
+
+  pp_ada_namespace_prefix (pp, context);
+  bool space_found = false;
+  char *name = to_ada_name (IDENTIFIER_POINTER (DECL_NAME (context)),
+			    &space_found);
+  pp_string (pp, name);
+  pp_underscore (pp);
+  free (name);
+}
+
 static bool package_prefix = true;
@@ -1410,12 +1433,15 @@ pp_ada_tree_identifier (pretty_printer *pp, tree node, tree type,
 	  if (separate_class_package (decl))
 	    {
 	      pp_string (pp, "Class_");
+	      pp_ada_namespace_prefix (pp, decl);
 	      pp_string (pp, s);
 	      pp_dot (pp);
 	    }
 	}
     }
 
+  pp_ada_namespace_prefix (pp, decl);
+
   if (space_found)
     if (!strcmp (s, "short_int"))
       pp_string (pp, "short");
