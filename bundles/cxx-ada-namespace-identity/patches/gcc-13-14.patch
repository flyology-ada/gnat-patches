diff --git a/gcc/c-family/c-ada-spec.cc b/gcc/c-family/c-ada-spec.cc
--- a/gcc/c-family/c-ada-spec.cc
+++ b/gcc/c-family/c-ada-spec.cc
@@ -1316,6 +1316,29 @@ to_ada_name (const char *name, bool *space_found)
   return s;
 }
 
+/* Dump the named C++ namespace path containing DECL, using underscores as
+   separators so the entity remains in the generated Ada package.  */
+
+static void
+pp_ada_namespace_prefix (pretty_printer *buffer, tree decl)
+{
+  if (!cpp_check || !decl)
+    return;
+
+  tree context = DECL_CONTEXT (decl);
+  if (!context || TREE_CODE (context) != NAMESPACE_DECL
+      || !DECL_NAME (context))
+    return;
+
+  pp_ada_namespace_prefix (buffer, context);
+  bool space_found = false;
+  char *name = to_ada_name (IDENTIFIER_POINTER (DECL_NAME (context)),
+			    &space_found);
+  pp_string (buffer, name);
+  pp_underscore (buffer);
+  free (name);
+}
+
 /* Return true if DECL refers to a C++ class type for which a
    separate enclosing package has been or should be generated.  */
 
@@ -1356,12 +1379,15 @@ pp_ada_tree_identifier (pretty_printer *buffer, tree node, tree type,
 	  if (separate_class_package (decl))
 	    {
 	      pp_string (buffer, "Class_");
+	      pp_ada_namespace_prefix (buffer, decl);
 	      pp_string (buffer, s);
 	      pp_dot (buffer);
 	    }
 	}
     }
 
+  pp_ada_namespace_prefix (buffer, decl);
+
   if (space_found)
     if (!strcmp (s, "short_int"))
       pp_string (buffer, "short");
diff --git a/gcc/testsuite/g++.dg/ada-spec/namespace-identity.C b/gcc/testsuite/g++.dg/ada-spec/namespace-identity.C
