@@ -2189,6 +2189,12 @@ dump_ada_node (pretty_printer *pp, tree node, tree type, int spc,
 	pp_string (pp, "address");
       break;
 
+    case OFFSET_TYPE:
+      /* The Itanium C++ ABI represents a data-member pointer as a ptrdiff_t
+	offset, with -1 reserved for null.  */
+      pp_string (pp, "ptrdiff_t");
+      break;
+
     case VECTOR_TYPE:
       pp_string (pp, "<vector>");
       break;
@@ -2292,6 +2298,15 @@ dump_ada_node (pretty_printer *pp, tree node, tree type, int spc,
 	dump_ada_node (pp, TYPE_NAME (node), node, spc, limited_access,
 		       true);
 
+      else if (TREE_CODE (TREE_TYPE (node)) == METHOD_TYPE)
+	{
+	  /* A member-function pointer's first word is either a function pointer
+	     or an encoded virtual-table offset, so it is not an Ada access-to-
