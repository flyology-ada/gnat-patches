+
+static const char *
+allocated_class_package_name (tree decl)
+{
+  bool space_found = false;
+  char *source = to_ada_name (IDENTIFIER_POINTER (DECL_NAME (decl)),
+			      &space_found);
+  const char *base
+    = allocate_ada_name (source, DECL_NAME (decl), ADA_NAME_SOURCE,
+			 DECL_CONTEXT (decl),
+			 LOCATION_FILE (decl_sloc (decl, false)), "_Case_");
+  char *candidate = concat ("Class_", base, NULL);
+  const char *allocated
+    = allocate_ada_name (candidate, TREE_TYPE (decl), ADA_NAME_CLASS_PACKAGE,
+			 DECL_CONTEXT (decl),
+			 LOCATION_FILE (decl_sloc (decl, false)), "_");
+  free (candidate);
+  free (source);
+  return allocated;
+}
