+/* Return the allocated name of an unnamed C++ base component.  NUMBER is its
+   one-based position among represented fields.  */
+
+static const char *
+allocated_synthetic_field_name (tree owner, tree field, int number)
+{
+  char candidate[32];
+  if (number == 1)
+    strcpy (candidate, "parent");
+  else
+    snprintf (candidate, sizeof (candidate), "field_%d", number);
+  tree decl = get_underlying_decl (owner);
+  gcc_assert (decl);
+  const char *allocated
+    = allocate_ada_name (candidate, field, ADA_NAME_SYNTHETIC_FIELD,
+			 owner, LOCATION_FILE (decl_sloc (decl, false)),
+			 "_Base_");
+  return allocated;
+}
