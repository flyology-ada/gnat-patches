diff --git a/gcc/c-family/c-ada-spec.cc b/gcc/c-family/c-ada-spec.cc
index b50b38775..5c4c454af 100644
--- a/gcc/c-family/c-ada-spec.cc
+++ b/gcc/c-family/c-ada-spec.cc
@@ -1512,6 +1512,18 @@ dump_ada_import (pretty_printer *buffer, tree t, int spc)
   const bool is_stdcall
     = TREE_CODE (t) == FUNCTION_DECL
       && lookup_attribute ("stdcall", TYPE_ATTRIBUTES (TREE_TYPE (t)));
+  bool uses_vector_abi = false;
+
+  if (TREE_CODE (t) == FUNCTION_DECL)
+    {
+      tree function_type = TREE_TYPE (t);
+
+      uses_vector_abi = TREE_CODE (TREE_TYPE (function_type)) == VECTOR_TYPE;
+      for (tree args = TYPE_ARG_TYPES (function_type);
+	   args && !uses_vector_abi;
+	   args = TREE_CHAIN (args))
+	uses_vector_abi = TREE_CODE (TREE_VALUE (args)) == VECTOR_TYPE;
+    }
 
   pp_string (buffer, "with Import => True, ");
 
@@ -1519,6 +1531,11 @@ dump_ada_import (pretty_printer *buffer, tree t, int spc)
 
   if (is_stdcall)
     pp_string (buffer, "Convention => Stdcall, ");
+  else if (uses_vector_abi)
+    /* GNAT's foreign conventions pass an Ada array by reference even after
+	vector_type changes its machine mode.  The Ada convention passes the
+	vector mode directly and therefore matches the C and C++ vector ABI.  */
+    pp_string (buffer, "Convention => Ada, ");
   else if (name[0] == '_' && name[1] == 'Z')
     pp_string (buffer, "Convention => CPP, ");
   else
@@ -2130,7 +2147,20 @@ dump_ada_node (pretty_printer *buffer, tree node, tree type, int spc,
       break;
 
     case VECTOR_TYPE:
-      pp_string (buffer, "<vector>");
+      if (name_only && TYPE_NAME (node))
+	dump_ada_node (buffer, TYPE_NAME (node), node, spc, limited_access,
+		       true);
+      else
+	{
+	  unsigned HOST_WIDE_INT subparts
+	    = TYPE_VECTOR_SUBPARTS (node).to_constant ();
+
+	  pp_string (buffer, "array (0 .. ");
+	  pp_unsigned_wide_integer (buffer, subparts - 1);
+	  pp_string (buffer, ") of ");
+	  dump_ada_node (buffer, TREE_TYPE (node), node, spc, limited_access,
+			 true);
+	}
       break;
 
     case COMPLEX_TYPE:
@@ -2983,6 +3013,10 @@ dump_ada_declaration (pretty_printer *buffer, tree t, tree type, int spc)
 	      pp_string (buffer, "type ");
 	    break;
 
+	  case VECTOR_TYPE:
+	    pp_string (buffer, "type ");
+	    break;
+
 	  case FUNCTION_TYPE:
 	    pp_string (buffer, "--  skipped function type ");
 	    dump_ada_node (buffer, t, type, spc, false, true);
@@ -3314,6 +3348,22 @@ dump_ada_declaration (pretty_printer *buffer, tree t, tree type, int spc)
     {
       pp_string (buffer, ";  -- ");
       dump_sloc (buffer, t);
+
+      if (TREE_CODE (t) == TYPE_DECL
+	  && TREE_CODE (TREE_TYPE (t)) == VECTOR_TYPE)
+	{
+	  newline_and_indent (buffer, spc);
+	  pp_string (buffer, "for ");
+	  dump_ada_node (buffer, t, type, spc, false, true);
+	  pp_string (buffer, "'Alignment use ");
+	  pp_decimal_int (buffer,
+			  TYPE_ALIGN (TREE_TYPE (t)) / BITS_PER_UNIT);
+	  pp_semicolon (buffer);
+	  newline_and_indent (buffer, spc);
+	  pp_string (buffer, "pragma Machine_Attribute (");
+	  dump_ada_node (buffer, t, type, spc, false, true);
+	  pp_string (buffer, ", \"vector_type\");");
+	}
     }
 
   return 1;
diff --git a/gcc/testsuite/g++.dg/ada-spec/vector-types.C b/gcc/testsuite/g++.dg/ada-spec/vector-types.C
new file mode 100644
index 000000000..445ba88ef
--- /dev/null
+++ b/gcc/testsuite/g++.dg/ada-spec/vector-types.C
@@ -0,0 +1,24 @@
+/* { dg-do compile } */
+/* { dg-options "-fdump-ada-spec-slim" } */
+/* { dg-final { scan-file vector_types_c.ads "type Int_Vector is array \(0 .. 3\) of int;" } } */
+/* { dg-final { scan-file vector_types_c.ads "for Int_Vector'Alignment use 16;" } } */
+/* { dg-final { scan-file vector_types_c.ads "pragma Machine_Attribute \(Int_Vector, \"vector_type\"\);" } } */
+/* { dg-final { scan-file vector_types_c.ads "type Double_Vector is array \(0 .. 1\) of double;" } } */
+/* { dg-final { scan-file vector_types_c.ads "Convention => Ada" } } */
+
+typedef int Int_Vector __attribute__((vector_size(16)));
+typedef double Double_Vector __attribute__((vector_size(16)));
+
+Int_Vector
+vector_identity (Int_Vector value)
+{
+  return value;
+}
+
+Double_Vector
+double_vector_identity (Double_Vector value)
+{
+  return value;
+}
+
+/* { dg-final { cleanup-ada-spec } } */
