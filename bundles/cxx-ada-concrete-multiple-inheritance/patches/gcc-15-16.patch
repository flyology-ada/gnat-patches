+/* Return whether TYPE maps to an Ada interface: it contains only a virtual
+   table field and abstract methods.  */
+
+static bool
+is_ada_interface_type (tree type)
+{
+  if (!cpp_check || !RECORD_OR_UNION_TYPE_P (type))
+    return false;
+
+  bool has_fields = false;
+  bool is_interface = false;
+  for (tree fld = TYPE_FIELDS (type); fld; fld = TREE_CHAIN (fld))
+    {
+      if (TREE_CODE (fld) == FIELD_DECL)
+	{
+	  if (!has_fields && DECL_VIRTUAL_P (fld))
+	    is_interface = true;
+	  else
+	    is_interface = false;
+	  has_fields = true;
+	}
+      else if (TREE_CODE (fld) == FUNCTION_DECL && !DECL_ARTIFICIAL (fld)
+	       && !cpp_check (fld, IS_ABSTRACT))
+	is_interface = false;
+    }
+
+  return is_interface;
+}
